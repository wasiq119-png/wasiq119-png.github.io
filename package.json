{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Wasiq Mudasar portfolio v2 (Three.js, vanilla ES modules)",
  "scripts": {
    "build:scene": "esbuild src/scene.js --bundle --format=esm --minify --target=es2020 --outfile=js/scene.js",
    "build:main": "esbuild src/main.js --minify --target=es2020 --outfile=js/main.js",
    "build": "npm run build:scene && npm run build:main"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
